{
  "uid": "docker-application",
  "title": "Docker Application",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "docker",
    "monitoring"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Endpoint request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "monitoring-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(requests_total{job=~\"service-a|service-b\"}[5m]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "monitoring-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, status_code) (rate(http_responses_total{job=~\"service-a|service-b\",status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{job}} {{status_code}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Endpoint P95 processing time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "monitoring-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"service-a|service-b\"}[5m])))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP 5xx percentage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "monitoring-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by (job) (rate(http_responses_total{job=~\"service-a|service-b\",status_code=~\"5..\"}[5m])) or on(job) (0 * sum by (job) (rate(http_responses_total{job=~\"service-a|service-b\"}[5m])))) / clamp_min(sum by (job) (rate(http_responses_total{job=~\"service-a|service-b\"}[5m])), 1e-9))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Application scrape availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "monitoring-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"service-a|service-b\"}",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "All HTTP response rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "monitoring-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, status_code) (rate(http_responses_total{job=~\"service-a|service-b\"}[5m]))",
          "legendFormat": "{{job}} {{status_code}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "editable": false
}
