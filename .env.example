# Copy to .env; never commit .env or real credentials.
# Existing installs keep their current SMTP behavior; new installs can disable it.
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=

# cAdvisor uses the Docker host PID namespace to reach its containerd socket.
# Legacy Docker installations may use /proc/1/root/run/docker/containerd/containerd.sock.
CADVISOR_CONTAINERD_SOCKET=/proc/1/root/run/containerd/containerd.sock
